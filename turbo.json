{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "GITHUB_TOKEN",
    "APPLEID",
    "APPLEIDPASS",
    "TEAMID",
    "CSC_KEY_PASSWORD",
    "CSC_LINK",
    "SENTRY_AUTH_TOKEN"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      // PORT and ONTIME_DATA must be declared: turbo runs in strict env mode by
      // default and drops every variable a task does not list. Playwright starts
      // this task to run the e2e servers, and without these the server ignored the
      // pinned port and the isolated data folder - it came up on whatever port
      // app-state.json remembered while Playwright waited on 4001, and touched the
      // developer's real data.
      "env": ["ROUTER_PREFIX", "IS_CLOUD", "PORT", "ONTIME_DATA"]
    },
    "dev:electron": {
      "cache": false,
      "persistent": true
    },
    "dev:inspect": {
      "cache": false,
      "persistent": true
    },

    "test": {},
    "test:pipeline": {},

    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },

    "dist-win": {
      "dependsOn": ["build", "ontime-ui#build", "ontime-server#build"],
      "outputs": ["dist/**"]
    },
    "dist-mac": {
      "dependsOn": ["build", "ontime-ui#build", "ontime-server#build"],
      "outputs": ["dist/**"]
    },
    "dist-linux": {
      "dependsOn": ["build", "ontime-ui#build", "ontime-server#build"],
      "outputs": ["dist/**"]
    }
  }
}
